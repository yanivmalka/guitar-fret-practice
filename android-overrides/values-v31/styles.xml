<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ (Android 12+) launch theme override.

  On these versions the platform always draws its own splash screen and ignores
  the pre-12 `@drawable/splash` window background that `capacitor-assets
  generate` produces. With nothing wiring up `windowSplashScreenAnimatedIcon`,
  the OS falls back to the adaptive launcher-icon foreground, which
  `capacitor-assets` emits at only 192px (xxxhdpi); stretched into the ~288dp
  system-splash slot it looks visibly blurry.

  This points the slot at a dedicated 1152px mark (assets/android12-splash-icon
  .png, generated by `npm run gen:icons`). `@capacitor/splash-screen` calls
  androidx `installSplashScreen()`, so `postSplashScreenTheme` hands control
  back to the normal no-action-bar theme once the WebView is up and
  index.html's own #boot-splash takes over.

  The APK workflow copies this file to
  android/app/src/main/res/values-v31/styles.xml after `capacitor-assets
  generate`.
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#141426</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/android12_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
