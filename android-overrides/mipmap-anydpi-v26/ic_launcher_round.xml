<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant of the adaptive launcher icon. Identical to ic_launcher.xml in
  this directory - see its comment for why the generated files are overridden.
  The manifest's android:roundIcon="@mipmap/ic_launcher_round" resolves here on
  API 26+; the two must stay in sync.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_adaptive_fg" />
</adaptive-icon>
