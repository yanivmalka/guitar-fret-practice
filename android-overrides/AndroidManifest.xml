<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the AndroidManifest.xml that `npx cap add android` generates. It is
  the stock Capacitor 8 template PLUS one addition: a second <intent-filter> on
  MainActivity for the `com.guitarfretpractice.app://auth-callback` deep link,
  so Google's OAuth redirect returns into the app (handled in src/hooks/useAuth
  via @capacitor/app's appUrlOpen) instead of being stranded in a browser tab.

  MainActivity already has `android:launchMode="singleTask"` in the stock
  template, which is what lets the returning deep link resume the existing
  Activity rather than spawning a new one.

  The APK workflow copies this file into the generated android/ project after
  `cap add`. If Capacitor's template changes on a major upgrade, re-diff this
  against a fresh `npx cap add android` and re-apply just the auth-callback
  intent-filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback deep link. Keep in sync with NATIVE_AUTH_REDIRECT
                 in src/utils/supabase.ts and the Supabase Redirect URLs list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.guitarfretpractice.app" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
