# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon key is safe to ship in the client bundle; row access is enforced by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Local admin scripts only (scripts/grant-pro.mts) ──────────────────────────
# The service_role key bypasses RLS — NEVER commit a real value and NEVER put it
# in a VITE_* var (that would ship it in the client bundle). Vite does not read
# these; only the hand-run Node scripts do.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Ads (Free tier only; Pro/Premium never see them) ──────────────────────────
# All public ids — they ship in the app. Leave empty to run with Google's TEST
# ads on Android/iOS and the house placeholder strip on the web.
# AdMob banner ad-unit ids, one per platform ("ca-app-pub-…/…"). The matching
# AdMob *app* id goes in android-overrides/AndroidManifest.xml (Android) and
# Info.plist GADApplicationIdentifier (iOS, once an ios/ project exists).
VITE_ADMOB_ANDROID_BANNER_ID=
VITE_ADMOB_IOS_BANNER_ID=
# Force test ads even with real ids set (e.g. a staging APK): 1 = test.
VITE_ADS_TESTING=
# AdSense, for the web/PWA build: publisher id ("ca-pub-…") and an ad-slot id.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
