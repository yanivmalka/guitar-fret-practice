# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon key is safe to ship in the client bundle; row access is enforced by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Local admin scripts only (scripts/grant-pro.mts) ──────────────────────────
# The service_role key bypasses RLS — NEVER commit a real value and NEVER put it
# in a VITE_* var (that would ship it in the client bundle). Vite does not read
# these; only the hand-run Node scripts do.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
